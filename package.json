{
  "name": "anatomy-workspace-dev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3016 --strictPort",
    "check": "tsc --noEmit",
    "test": "node tests/domain.test.mjs",
    "test:browser": "node tests/workspace-browser.mjs",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "build:client": "vite build --mode client",
    "tauri": "tauri",
    "client:dev": "tauri dev",
    "client:build:linux": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,appimage",
    "client:build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "client:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "ci:check": "npm run check && npm test && npm run build && npm run build:pages && npm run build:client",
    "prebuild": "node tools/prepare-legal.mjs",
    "prebuild:pages": "node tools/prepare-legal.mjs",
    "prebuild:client": "node tools/prepare-legal.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-opener": "2.5.0",
    "fflate": "0.8.3",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.159.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.159.0",
    "@vitejs/plugin-react": "6.0.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "type": "module",
  "license": "MIT"
}
